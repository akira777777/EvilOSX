{
    "version": "0.2.0",
    "configurations": [
        {
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "name": "Запустить расширение",
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "npm",
            "request": "launch",
            "type": "extensionHost"
        },
        {
            "name": "EvilOSX: Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/start.py",
            "args": [
                "--port",
                "1337"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "presentation": {
                "group": "1-Server",
                "order": 1
            }
        },
        {
            "name": "EvilOSX: Server (custom arguments)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/start.py",
            "args": "${command:pickArgs}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "presentation": {
                "group": "1-Server",
                "order": 2
            }
        },
        {
            "name": "EvilOSX: Builder (generate launcher)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/start.py",
            "args": [
                "--builder",
                "--host",
                "127.0.0.1",
                "--port",
                "1337"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "presentation": {
                "group": "1-Server",
                "order": 3
            }
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "presentation": {
                "group": "2-Scripts",
                "order": 1
            }
        },
        {
            "name": "Python: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": "${command:pickArgs}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "presentation": {
                "group": "2-Scripts",
                "order": 2
            }
        },
        {
            "name": "EvilOSX: nginx facade test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/test_nginx_facade.py",
            "args": [
                "--host",
                "127.0.0.1",
                "--port",
                "1337"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "presentation": {
                "group": "3-Tests",
                "order": 1
            }
        },
        {
            "name": "EvilOSX: nginx facade test (custom arguments)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/test_nginx_facade.py",
            "args": "${command:pickArgs}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "presentation": {
                "group": "3-Tests",
                "order": 2
            }
        }
    ]
}